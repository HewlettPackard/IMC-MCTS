include README.md REPRODUCIBILITY.md VALIDATION.md THIRD_PARTY_NOTICES.md LICENSE
include MANIFEST.json Makefile reproduce.py requirements*.txt tested_environment.json
include RELEASE_STATUS.json DISTRIBUTION_INVENTORY.json DISTRIBUTION.md
recursive-include LICENSES *
recursive-include baselines *
recursive-include configs *
recursive-include data *
recursive-include figures *
recursive-include validation *
recursive-include release_tests *.py
recursive-include source *
global-exclude *.py[cod] .DS_Store
prune source/__pycache__
prune source/build
prune source/dist

include CITATION.cff CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md .gitignore SBOM.cdx.json SBOM_SCOPE.md
recursive-include .github *.yml
recursive-include tools *.py
